{
  "mcpServers": {
    "osint-infra": {
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp-servers/osint-infra/.venv/bin/python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/osint-infra/server.py"
      ]
    },
    "threat-intel": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/threat-intel",
        "server.py"
      ],
      "env": {
        "VT_API_KEY": "${VT_API_KEY}",
        "ABUSE_CH_AUTH_KEY": "${ABUSE_CH_AUTH_KEY}"
      }
    },
    "perplexity-ask": {
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server@1.3.0"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "reddit": {
      "command": "uvx",
      "args": [
        "reddit-no-auth-mcp-server"
      ]
    },
    "apify": {
      "command": "npx",
      "args": [
        "-y",
        "@apify/actors-mcp-server@0.9.10"
      ],
      "env": {
        "APIFY_TOKEN": "${APIFY_TOKEN}",
        "TELEMETRY_ENABLED": "false",
        "TOOLS": "actors,apify/instagram-hashtag-scraper,apify/instagram-profile-scraper,apify/instagram-post-scraper,clockworks/tiktok-scraper,clockworks/tiktok-profile-scraper,curious_coder/twitter-scraper,apify/web-scraper"
      }
    },
    "notebooklm": {
      "command": "npx",
      "args": [
        "-y",
        "@roomi-fields/notebooklm-mcp@3.2.0"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless"
      ]
    },
    "builtwith": {
      "url": "https://api.builtwith.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BUILTWITH_API_KEY}"
      }
    }
  }
}
